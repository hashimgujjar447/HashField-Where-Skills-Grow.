<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Confirmation</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background: #f4f6f8;
      font-family: Arial, Helvetica, sans-serif;
      color: #1f2937;
    }

    .wrapper {
      width: 100%;
      padding: 40px 15px;
    }

    .container {
      max-width: 620px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid #e5e7eb;
    }

    .header {
      padding: 32px 25px;
      text-align: center;
      background: #2563eb;
      color: #ffffff;
    }

    .check {
      width: 54px;
      height: 54px;
      margin: 0 auto 15px;
      border-radius: 50%;
      background: #ffffff;
      color: #2563eb;
      font-size: 30px;
      line-height: 54px;
      font-weight: bold;
    }

    .header h1 {
      margin: 0 0 8px;
      font-size: 27px;
      font-weight: 700;
    }

    .header p {
      margin: 0;
      font-size: 15px;
      opacity: 0.92;
    }

    .content {
      padding: 35px 30px;
    }

    .content h2 {
      margin: 0 0 10px;
      font-size: 21px;
      color: #111827;
    }

    .content > p {
      margin: 0 0 25px;
      font-size: 15px;
      line-height: 1.7;
      color: #6b7280;
    }

    .order-box {
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      overflow: hidden;
    }

    .order-title {
      padding: 15px 18px;
      background: #f8fafc;
      border-bottom: 1px solid #e5e7eb;
      font-size: 16px;
      font-weight: 700;
      color: #111827;
    }

    .order-table {
      width: 100%;
      border-collapse: collapse;
    }

    .order-table td {
      padding: 14px 18px;
      border-bottom: 1px solid #f1f5f9;
      font-size: 14px;
      vertical-align: top;
    }

    .order-table tr:last-child td {
      border-bottom: 0;
    }

    .label {
      width: 38%;
      color: #6b7280;
      font-weight: 600;
    }

    .value {
      color: #111827;
      font-weight: 500;
    }

    .price {
      font-size: 17px;
      font-weight: 700;
      color: #2563eb;
    }

    .success {
      margin-top: 25px;
      padding: 15px 17px;
      border-radius: 9px;
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      color: #166534;
      font-size: 14px;
      line-height: 1.6;
    }

    .footer {
      padding: 22px 25px;
      text-align: center;
      background: #f8fafc;
      border-top: 1px solid #e5e7eb;
      color: #6b7280;
      font-size: 13px;
      line-height: 1.6;
    }

    .footer p {
      margin: 4px 0;
    }

    @media only screen and (max-width: 600px) {
      .wrapper {
        padding: 20px 10px;
      }

      .content {
        padding: 28px 20px;
      }

      .header {
        padding: 28px 20px;
      }

      .header h1 {
        font-size: 23px;
      }

      .order-table td {
        padding: 12px;
      }

      .label {
        width: 42%;
      }
    }
  </style>
</head>

<body>
  <div class="wrapper">
    <div class="container">

      <div class="header">
        <div class="check">✓</div>
        <h1>Order Confirmed!</h1>
        <p>Your course has been successfully purchased.</p>
      </div>

      <div class="content">
        <h2>Thank you for your order!</h2>

        <p>
          Your order has been successfully placed. Here are the details of your purchase.
        </p>

        <div class="order-box">
          <div class="order-title">Order Details</div>

          <table class="order-table">
            <tr>
              <td class="label">Order ID</td>
              <td class="value">#<%= order._id %></td>
            </tr>

            <tr>
              <td class="label">Course</td>
              <td class="value"><%= order.name %></td>
            </tr>

            <tr>
              <td class="label">Order Date</td>
              <td class="value"><%= order.date %></td>
            </tr>

            <tr>
              <td class="label">Amount Paid</td>
              <td class="value price">Rs. <%= order.price %></td>
            </tr>
          </table>
        </div>

        <div class="success">
          Your payment has been received successfully. You can now access your purchased course from your account.
        </div>
      </div>

      <div class="footer">
        <p><strong>Happy Learning!</strong></p>
        <p>This is an automated email. Please do not reply to this email.</p>
      </div>

    </div>
  </div>
</body>
</html>
